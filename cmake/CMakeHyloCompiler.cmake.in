set(CMAKE_Hylo_COMPILER "@CMAKE_Hylo_COMPILER@")
set(CMAKE_Hylo_HOST_LINKER "@CMAKE_Hylo_HOST_LINKER@")
set(CMAKE_Hylo_STDLIB_ROOT "@CMAKE_Hylo_STDLIB_ROOT@")
set(CMAKE_Hylo_STDLIB_SHIMS "@CMAKE_Hylo_STDLIB_SHIMS@")
set(CMAKE_Hylo_COMPILER_ID "@CMAKE_Hylo_COMPILER_ID@")
set(CMAKE_Hylo_COMPILER_VERSION "@CMAKE_Hylo_COMPILER_VERSION@")
set(CMAKE_Hylo_COMPILER_LOADED 1)
set(CMAKE_Hylo_COMPILER_WORKS @CMAKE_Hylo_COMPILER_WORKS@)
set(CMAKE_Hylo_COMPILER_FORCED @CMAKE_Hylo_COMPILER_FORCED@)
set(CMAKE_Hylo_COMPILER_ENV_VAR "HC")

set(CMAKE_Hylo_SOURCE_FILE_EXTENSIONS hylo)
set(CMAKE_Hylo_IGNORE_EXTENSIONS o;O;obj;OBJ)
set(CMAKE_Hylo_OUTPUT_EXTENSION .o)
set(CMAKE_Hylo_LINKER_PREFERENCE 40)
set(CMAKE_Hylo_LINKER_PREFERENCE_PROPAGATES 1)
