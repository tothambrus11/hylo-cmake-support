// Hylo bindings for the ev3c C library (ev3/libev3c).
//
// Every function is implemented in C (ev3c_hylo.c) and called through the
// indirect C calling convention: `@extern_c_indirect` passes each parameter
// by pointer and returns through a trailing pointer, so the C side is
//   void ev3_drive_indirect(int32_t const* left, int32_t const* right);
// Keeping the API to Int32 and Bool is deliberate: that is what Hylo v0.0.6
// can pass across the boundary today, and a line follower needs nothing else.
//
// Parameter labels: in this Hylo version `_ left: Int32` declares a parameter
// that is called with the label `left:`; a bare `x: Int32` is unlabeled.

/// Initialises sensor and motors. Returns 0 on success.
@extern_c_indirect("ev3_init_indirect")
public fun ev3_init() -> Int32

/// Stops the motors and releases the devices.
@extern_c_indirect("ev3_shutdown_indirect")
public fun ev3_shutdown()

/// `true` until Ctrl-C / SIGTERM / the brick's BACK button.
@extern_c_indirect("ev3_running_indirect")
public fun ev3_running() -> Bool

/// Reflected light from the colour sensor, 0 (black) .. 100 (white); -1 on error.
@extern_c_indirect("ev3_color_reflect_indirect")
public fun ev3_color_reflect() -> Int32

/// Runs the motors at the given percentages of full speed (-100 .. 100).
@extern_c_indirect("ev3_drive_indirect")
public fun ev3_drive(_ left: Int32, _ right: Int32)

/// Brakes both motors.
@extern_c_indirect("ev3_stop_indirect")
public fun ev3_stop()

/// Motor position in degrees; side 0 = left, 1 = right.
@extern_c_indirect("ev3_motor_position_indirect")
public fun ev3_motor_position(_ side: Int32) -> Int32

/// Sleeps for `ms` milliseconds.
@extern_c_indirect("ev3_sleep_ms_indirect")
public fun ev3_sleep(_ ms: Int32)

/// Milliseconds since `ev3_init()`.
@extern_c_indirect("ev3_millis_indirect")
public fun ev3_millis() -> Int32

/// Prints "tag=value" on stdout (shows up over ssh, on the LCD via Brickman,
/// and in the simulator log).
@extern_c_indirect("ev3_log_indirect")
public fun ev3_log(_ tag: Int32, _ value: Int32)
